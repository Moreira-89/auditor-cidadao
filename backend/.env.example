# Copie este arquivo para ".env" (`cp .env.example .env`) e preencha com suas chaves.
# Nunca versione o ".env" real — ele já está listado no .gitignore.

# ── LLM ────────────────────────────────────────────────────────────────────
# Formato: "provider:model-name". O provider precisa ter a respectiva chave de
# API preenchida abaixo e o pacote langchain-<provider> instalado (ver requirements.txt).
# Exemplos: "openai:gpt-4o-mini" | "groq:llama-3.3-70b-versatile" | "google_genai:gemini-2.0-flash"
LLM_MODEL=openai:gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Timeout (segundos) e nº de retries por chamada ao LLM — evita que uma resposta
# lenta da OpenAI segure o turno (e o streaming SSE) indefinidamente. Reusados pelo
# modelo extrator (EXTRATOR_MODEL) abaixo.
LLM_TIMEOUT_SEGUNDOS=60
LLM_MAX_RETRIES=2

# Modelo usado apenas para extrair o laudo estruturado (JSON) a partir do Markdown
# já gerado pelo agente. Separado do LLM_MODEL para permitir trocar um sem afetar o outro.
EXTRATOR_MODEL=openai:gpt-4o-mini
EXTRATOR_TEMPERATURE=0.0

# ── Chaves de API dos provedores de LLM ─────────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui
# Obrigatória mesmo que LLM_MODEL/EXTRATOR_MODEL usem outro provider — os embeddings
# do RAG (text-embedding-3-small) sempre usam a OpenAI.

GROQ_API_KEY=sua_chave_groq_aqui
# Obrigatória apenas se LLM_MODEL ou EXTRATOR_MODEL usarem o provider "groq:...".

GOOGLE_API_KEY=sua_chave_google_aqui
# Obrigatória apenas se LLM_MODEL ou EXTRATOR_MODEL usarem o provider "google_genai:...".

# ── Banco vetorial (RAG hierárquico do edital — MongoDB Atlas) ───────────────
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
# Obrigatória. Precisa ser um cluster Atlas (Vector Search não existe em Mongo
# self-hosted/local). Banco "auditor_cidadao", coleção "chunks_edital", com um
# índice vectorSearch chamado "idx_chunks_vetor" — ver app/storage/mongo_db.py.

EMBEDDING_MODEL=text-embedding-3-small
# Modelo de embedding da OpenAI usado para indexar e buscar. Ao trocar, REINDEXE
# tudo (o espaço vetorial muda) e recrie o índice vectorSearch com a nova dimensão.

TOP_K_EDITAL=5
# Quantos filhos a busca vetorial casa por pergunta — ver a tool
# buscar_contexto_edital em app/agents/tools/contexto_edital.py.

MONGO_RETENCAO_DIAS=2
# Dias de retenção dos chunks com origem "upload_usuario" antes de o job
# app/jobs/limpeza_mongo.py apagá-los.

# ── Redis (checkpointer do grafo + rate limiting) ────────────────────────────
REDIS_URI=redis://localhost:6379
# Precisa de uma instância Redis rodando (local, Docker ou Railway) — sem ela o
# boot da aplicação falha. Duas conexões distintas usam essa mesma URI:
# - AsyncRedisSaver (app/services/lifespan.py): persiste o histórico de conversa
#   por thread_id, compartilhado entre workers/instâncias.
# - app/services/rate_limiter.py: conta requisições por cliente (cookie) e janela
#   de tempo, para limitar uso de /upload/ e /conversar-com-auditor/.

TTL_CHECKPOINT_MINUTOS=1440
# Minutos de INATIVIDADE até o histórico de uma conversa expirar no Redis (default
# 1440 = 24h). Não é um TTL fixo desde a criação: cada leitura renova a contagem
# (refresh_on_read), então uma conversa em uso nunca expira no meio — só threads
# abandonadas são limpas. Use -1 para desativar a expiração (persistente).

# ── Segurança: cookie de identificação de cliente (rate limiting) ───────────
COOKIE_SECRET_KEY=troque_por_uma_chave_secreta_aleatoria_e_longa
# Assina o cookie httpOnly (auditor_client_id) usado para identificar o mesmo
# navegador entre requisições sem exigir login — ver app/utils/cookie_manager.py
# e app/api/dependencies_http.py. Se não definida, o servidor gera uma chave
# aleatória em memória no boot (os cookies emitidos não sobrevivem a um restart).
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"

AMBIENTE_PRODUCAO=False
# Controla a flag `secure` do cookie acima e o `samesite` (lax em dev, none em
# produção — necessário para o cookie ser aceito em requisições cross-site do
# frontend, que é um serviço/domínio separado no Railway). True (produção,
# HTTPS) faz o navegador só reenviar o cookie em conexões HTTPS. Em dev local
# (uvicorn sem TLS), deixe False — senão o cookie nunca persiste entre
# requisições e o rate limiter nunca reconhece o mesmo cliente duas vezes.

CORS_ORIGINS=https://auditorcidadao.up.railway.app
# URL(s) pública(s) do serviço de frontend autorizadas a chamar esta API via
# CORS, separadas por vírgula. Preencher em produção com o domínio do serviço
# de frontend no Railway.
# Em dev NÃO precisa mexer: com AMBIENTE_PRODUCAO=False, o backend libera
# http://localhost:5173 (Vite) automaticamente — o frontend roda separado e
# toda chamada dele é cross-site (ver app/config/settings.py).

# ── Fontes de dados oficiais (tools nativas) ─────────────────────────────────
TAVILY_API_KEY=sua_chave_tavily_aqui
# Usada pela tool buscar_informacao_web (busca complementar na internet).

CGU_API_KEY=sua_chave_cgu_aqui
# Usada pela tool consultar_sancoes_empresa (CEIS/CNEP do Portal da Transparência).
# Obtenha em https://api.portaldatransparencia.gov.br/swagger-ui.html
