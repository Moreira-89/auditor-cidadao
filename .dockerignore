# Ambiente virtual Python — recriado no container via requirements.txt
.venv/
__pycache__/
*.pyc
*.pyo

# Variáveis de ambiente — NÃO vão para o container (ficam no Railway/Render).
.env
.env.docker

# Controle de versão
.git/
.gitignore

# Documentação (MkDocs) — hospedada separadamente no GitHub Pages, não precisa
# estar dentro da imagem que só serve a API + frontend estático.
docs/
mkdocs.yml
site/
README.md
AuditorCidadaoRoadmap.md
apresentacao_data_master/

# Avaliação (RAGAS) e testes locais — ferramental de desenvolvimento, não faz
# parte do runtime da API (evaluation/pipeline_avaliacao.py roda fora do container).
evaluation/
testes_locais/
test_mcp_connection.py
*.ipynb

# Dependências de dev (mkdocs + ragas) — só requirements.txt (runtime) é
# instalado na imagem; ver requirements-dev.txt para o que fica de fora.
requirements-dev.txt

# Docker em si
Dockerfile
.dockerignore

# IDEs e ferramentas de desenvolvimento
.vscode/
.idea/
.claude/
.ruff_cache/