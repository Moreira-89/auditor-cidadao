# Copie este arquivo para ".env" (`cp .env.example .env`) e preencha com suas chaves.
# Nunca versione o ".env" real — ele já está listado no .gitignore.

# ── LLM ────────────────────────────────────────────────────────────────────
# Formato: "provider:model-name". O provider precisa ter a respectiva chave de
# API preenchida abaixo e o pacote langchain-<provider> instalado (ver requirements.txt).
# Exemplos: "openai:gpt-4o-mini" | "groq:llama-3.3-70b-versatile" | "google_genai:gemini-2.0-flash"
LLM_MODEL=openai:gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Modelo usado apenas para extrair o laudo estruturado (JSON) a partir do Markdown
# já gerado pelo agente. Separado do LLM_MODEL para permitir trocar um sem afetar o outro.
EXTRATOR_MODEL=openai:gpt-4o-mini
EXTRATOR_TEMPERATURE=0.0

# ── Chaves de API dos provedores de LLM ─────────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui
# Obrigatória mesmo que LLM_MODEL/EXTRATOR_MODEL usem outro provider — os embeddings
# do RAG (text-embedding-3-small) sempre usam a OpenAI.

GROQ_API_KEY=sua_chave_groq_aqui
# Obrigatória apenas se LLM_MODEL ou EXTRATOR_MODEL usarem o provider "groq:...".

GOOGLE_API_KEY=sua_chave_google_aqui
# Obrigatória apenas se LLM_MODEL ou EXTRATOR_MODEL usarem o provider "google_genai:...".

# ── Banco de dados vetorial ──────────────────────────────────────────────────
PINECONE_API_KEY=sua_chave_pinecone_aqui
# Índice utilizado: "auditor-cidadao" (criado automaticamente pelo Pinecone se não existir).

# ── Fontes de dados oficiais (tools nativas) ─────────────────────────────────
TAVILY_API_KEY=sua_chave_tavily_aqui
# Usada pela tool buscar_informacao_web (busca complementar na internet).

CGU_API_KEY=sua_chave_cgu_aqui
# Usada pela tool consultar_sancoes_empresa (CEIS/CNEP do Portal da Transparência).
# Obtenha em https://api.portaldatransparencia.gov.br/swagger-ui.html
